# Single source of every setting in this repo. build.sh sources it and passes it to the Dockerfile.
#
# A series, not a version: each build starts FROM the official nginx:${NGINX_SERIES}-alpine, pulled
# fresh and pinned by digest, so every nginx 1.30.x fix (and the official image's Alpine rebuilds)
# lands on the moving tags without editing this file. The Dockerfile also runs `apk upgrade`, so
# Alpine security fixes do not wait for the official image to be rebuilt.
# To build on a given official tag instead (rollback, reproducing a build):
#   NGINX_BASE_TAG=1.30.6-alpine ./build.sh

NGINX_SERIES=1.30

# Security floor, enforced inside the image at build time (Dockerfile) and by tests/guard.sh.
# Raise it by hand on an nginx security release, so nothing older can be built or pushed.
MIN_NGINX_VERSION=1.30.6

# Production runs amd64 only.
PLATFORM=linux/amd64

# Our registry. In CI it must equal $CI_REGISTRY_IMAGE.
IMAGE=registry.developpeur-freelance.io/silent/nginx-redirect-docker
